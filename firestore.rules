rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Authenticated user can access their own root user document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Authenticated user can access all subcollections at any depth under their user ID
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

